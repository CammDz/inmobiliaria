<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">
    <description>Funciones EL para formatear precios en pesos colombianos.</description>
    <tlib-version>1.0</tlib-version>
    <short-name>cop</short-name>
    <uri>http://inmovain.com/tld/precio</uri>

    <function>
        <name>colombiano</name>
        <function-class>com.inmobiliaria.util.PrecioUtil</function-class>
        <function-signature>java.lang.String colombiano(double)</function-signature>
    </function>

    <function>
        <name>entero</name>
        <function-class>com.inmobiliaria.util.PrecioUtil</function-class>
        <function-signature>long entero(double)</function-signature>
    </function>
</taglib>