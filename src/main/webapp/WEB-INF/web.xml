<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Inmobiliaria Web</display-name>
    <description>Sistema de Gestión Inmobiliaria</description>

    <!-- Configuración de encoding UTF-8 -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>com.inmobiliaria.filter.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Filtro de autenticación y permisos -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.inmobiliaria.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/agente/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/cliente/*</url-pattern>
    </filter-mapping>

    <!-- Inicializador de datos de prueba -->
    <listener>
        <listener-class>com.inmobiliaria.util.DataInitializer</listener-class>
    </listener>

    <!-- Página de inicio -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Páginas de error -->
    <error-page>
        <error-code>403</error-code>
        <location>/acceso-denegado.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error/500.jsp</location>
    </error-page>

    <!-- Session timeout (30 minutos) -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <!-- Solo cookies: evita el JSESSIONID en la URL (protección contra
             robo/uso indebido de sesión) -->
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
</web-app>